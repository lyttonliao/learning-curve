{
  "$defs": {
    "Option": {
      "additionalProperties": false,
      "description": "An alternative that was weighed.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "title": "Option",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Evidence for a record.\n\n`ref` format depends on `kind`: `<session_id>:L<n>[-<m>]` for a transcript, `#42` or a URL\nfor a pull request, one or more commit SHAs when inferred.",
      "properties": {
        "kind": {
          "enum": [
            "transcript",
            "pr",
            "inferred"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An architecture decision record (ADR).",
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "provisional",
            "accepted"
          ],
          "type": "string"
        },
        {
          "pattern": "^superseded-by-\\d{4}$",
          "type": "string"
        }
      ],
      "title": "Status"
    },
    "context": {
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "options_considered": {
      "items": {
        "$ref": "#/$defs/Option"
      },
      "minItems": 2,
      "title": "Options Considered",
      "type": "array"
    },
    "chosen": {
      "minLength": 1,
      "title": "Chosen",
      "type": "string"
    },
    "tradeoffs": {
      "minLength": 1,
      "title": "Tradeoffs",
      "type": "string"
    },
    "upgrade_trigger": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upgrade Trigger"
    },
    "source": {
      "$ref": "#/$defs/Source"
    }
  },
  "required": [
    "title",
    "date",
    "status",
    "context",
    "options_considered",
    "chosen",
    "tradeoffs",
    "source"
  ],
  "title": "Decision",
  "type": "object"
}
